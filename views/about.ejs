<%- include('partials/head') %>
<%- include('partials/nav') %>

<section class="page-hero">
  <div class="container">
    <h1>About Me</h1>
    <p class="page-subtitle">Student, builder, occasional over-caffeinated debugger</p>
  </div>
</section>

<section class="section">
  <div class="container about-grid">
    <div class="about-main">
      <p class="lead"><%= profile.bio %></p>

      <h2>Education</h2>
      <div class="timeline-card">
        <div class="timeline-card-header">
          <h3><%= education.school %></h3>
          <span class="timeline-date"><%= education.period %></span>
        </div>
        <p class="timeline-role"><%= education.degree %></p>
        <p class="timeline-detail">GPA: <strong><%= education.gpa %></strong></p>
        <h4>Relevant Coursework</h4>
        <ul class="coursework-list">
          <% education.relevantCoursework.forEach(function(course) { %>
            <li><%= course %></li>
          <% }); %>
        </ul>
      </div>

      <h2>Experience</h2>
      <div class="timeline">
        <% experience.forEach(function(item) { %>
          <article class="timeline-item">
            <div class="timeline-marker"></div>
            <div class="timeline-content">
              <div class="timeline-card-header">
                <h3><%= item.role %></h3>
                <span class="timeline-date"><%= item.period %></span>
              </div>
              <p class="timeline-org"><%= item.org %></p>
              <p><%= item.description %></p>
            </div>
          </article>
        <% }); %>
      </div>
    </div>

    <aside class="about-sidebar">
      <div class="info-card">
        <h3>Details</h3>
        <dl class="info-list">
          <dt>Location</dt>
          <dd><%= profile.location %></dd>
          <dt>Degree</dt>
          <dd><%= profile.degree %></dd>
          <dt>Expected Graduation</dt>
          <dd><%= profile.year %></dd>
          <dt>Email</dt>
          <dd><a href="mailto:<%= profile.email %>"><%= profile.email %></a></dd>
        </dl>
      </div>

      <div class="info-card">
        <h3>Currently Learning</h3>
        <ul class="learning-list">
          <% profile.currentlyLearning.forEach(function(item) { %>
            <li><%= item %></li>
          <% }); %>
        </ul>
      </div>

      <div class="info-card">
        <h3>Interests</h3>
        <ul class="pill-list pill-list-sm">
          <% profile.interests.forEach(function(interest) { %>
            <li><%= interest %></li>
          <% }); %>
        </ul>
      </div>
    </aside>
  </div>
</section>

<%- include('partials/footer') %>
