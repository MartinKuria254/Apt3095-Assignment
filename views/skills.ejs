<%- include('partials/head') %>
<%- include('partials/nav') %>

<section class="page-hero">
  <div class="container">
    <h1>Skills</h1>
    <p class="page-subtitle">Tools I use, concepts I'm comfortable with, and things I'm still leveling up</p>
  </div>
</section>

<section class="section">
  <div class="container skills-grid">
    <% skills.forEach(function(group) { %>
      <div class="skill-group">
        <h2><%= group.category %></h2>
        <ul class="skill-bars">
          <% group.items.forEach(function(skill) { %>
            <li class="skill-bar-item">
              <div class="skill-bar-header">
                <span class="skill-name"><%= skill.name %></span>
                <span class="skill-level"><%= skill.level %>%</span>
              </div>
              <div class="skill-bar-track">
                <div class="skill-bar-fill" style="width: <%= skill.level %>%"></div>
              </div>
            </li>
          <% }); %>
        </ul>
      </div>
    <% }); %>
  </div>
</section>

<section class="section section-alt">
  <div class="container">
    <h2 class="text-center">Also familiar with</h2>
    <div class="familiar-grid">
      <span>Postman</span>
      <span>VS Code</span>
      <span>Figma basics</span>
      <span>Markdown</span>
      <span>JSON / YAML</span>
      <span>npm / pip</span>
      <span>GitHub Actions</span>
      <span>Responsive design</span>
      <span>Agile workflows</span>
      <span>Technical writing</span>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
